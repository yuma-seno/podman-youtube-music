# ── 必須設定（ここを編集するだけで動きます）────────────────────────────────

# DuckDNS のサブドメイン (例: yuma-music.duckdns.org)
DOMAIN=your-subdomain.duckdns.org

# DuckDNS の API トークン (duckdns.org ログイン後に右上に表示)
DUCKDNS_TOKEN=your-duckdns-token-here

# Let's Encrypt 証明書の通知用メールアドレス
ACME_EMAIL=your@email.com

# URL
URL=https://music.youtube.com/

# ── 自動ログイン設定（省略可能）──────────────────────────────────────────────
# コンテナ再起動後にログアウト状態になった場合、自動でGoogleにログインします。
# ⚠ パスワードが平文で保存されます。このファイルを厳重に管理してください。
# ⚠ 2段階認証が有効な場合は使用できません。
# GOOGLE_EMAIL=your@gmail.com
# GOOGLE_PASSWORD=your_password